# ── Web UI ───────────────────────────────────────────────────
# Web front end port for adjusting settings and viewing live alerts
WEB_PORT=8085

# ── Receiver ─────────────────────────────────────────────────
# tar1090 / readsb / ultrafeeder aircraft.json endpoint
ADSB_URL=http://localhost:8080/data/aircraft.json

# Base station coordinates (your target location for proximity detection)
BASE_LAT=40.7128
BASE_LON=-74.0060

# ── Gotify ───────────────────────────────────────────────────
GOTIFY_URL=http://localhost:8088
GOTIFY_APP_TOKEN=your_gotify_token_here

# ── Filtering ────────────────────────────────────────────────
# Maximum distance in miles to alert on
MAX_DISTANCE_MI=5.0

# Aircraft types to alert on (comma-separated)
# Options: helicopter, military_helo, plane, military_plane, medflight
ALERT_TYPES=helicopter,military_helo,military_plane,medflight

# Custom MedFlight tail numbers (comma-separated, optional)
# Air Methods, Life Flight, or regional medevac registrations
MEDFLIGHT_TAILS=N982LF,N136KY,N141NE,N143NE,N144NE,N145NE

# ── Polling ──────────────────────────────────────────────────
# How often to poll the receiver (seconds)
POLL_INTERVAL=10

# Cooldown before re-alerting the same aircraft (seconds)
ALERT_COOLDOWN=300

# ── Live Tracker URL ─────────────────────────────────────────
# Click-through for notifications. Default: Flightradar24.
# Options:
#   - https://www.flightradar24.com  (Flightradar24 live map & aircraft info)
#   - https://sky.example.com        (tar1090 / readsb map with ?icao=)
#   - https://globe.adsbexchange.com (ADSBexchange map with ?icao=)
TRACKER_URL=https://www.flightradar24.com
