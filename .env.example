# ── Receiver ─────────────────────────────────────────────────
# tar1090 / readsb / ultrafeeder aircraft.json endpoint
ADSB_URL=http://localhost:8080/data/aircraft.json

# Base station coordinates (your target location for proximity detection)
BASE_LAT=40.7128
BASE_LON=-74.0060

# ── Gotify ───────────────────────────────────────────────────
GOTIFY_URL=http://localhost:8088
GOTIFY_APP_TOKEN=your_gotify_token_here

# ── Filtering ────────────────────────────────────────────────
# Maximum distance in miles to alert on
MAX_DISTANCE_MI=5.0

# Aircraft types to alert on (comma-separated)
# Options: helicopter, military_helo, plane, military_plane
ALERT_TYPES=helicopter,military_helo,military_plane

# ── Polling ──────────────────────────────────────────────────
# How often to poll the receiver (seconds)
POLL_INTERVAL=10

# Cooldown before re-alerting the same aircraft (seconds)
ALERT_COOLDOWN=300

# ── Optional: Live Tracker URL ───────────────────────────────
# Link to your tar1090 or web radar (opens aircraft detail on click)
TRACKER_URL=https://sky.example.com
